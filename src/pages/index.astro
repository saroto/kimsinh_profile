---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import Education from "../components/Education.astro";
import Project from "../components/Project.astro";
import "../styles/global.css";
import { Image } from "astro:assets";
import profile from "../assets/kimsinh.png";
---

<Layout>
  <NavBar />

  <main class="w-full max-w-[1200px] mx-auto px-6 pt-32 pb-24 space-y-32">
    <!-- Hero Section -->
    <section
      class="flex flex-col-reverse lg:flex-row items-center justify-between gap-16 min-h-[60vh]"
    >
      <!-- Text Content -->
      <div
        class="flex-1 flex flex-col items-center text-center lg:items-start lg:text-left space-y-8 z-10"
      >
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-indigo-500/20 text-indigo-300 text-sm font-medium mb-4"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"
            ></span>
          </span>
          Available for new opportunities
        </div>

        <h1
          class="font-outfit text-5xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.1]"
        >
          Hi, I'm <br class="hidden md:block" />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400"
          >
            Kimsinh Seang
          </span>
        </h1>

        <p
          class="text-lg md:text-xl text-slate-400 max-w-2xl font-light leading-relaxed"
        >
          A passionate software developer specializing in building modern web
          applications. I transform ideas into elegant, highly performant, and
          user-friendly digital experiences.
        </p>

        <div
          class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4"
        >
          <a
            href="#projects"
            class="px-8 py-4 rounded-full bg-white text-slate-900 font-semibold hover:scale-105 transition-transform shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)]"
          >
            Explore My Work
          </a>
          <a
            href="#about"
            class="px-8 py-4 rounded-full glass border border-white/10 text-white font-medium hover:bg-white/10 transition-colors"
          >
            About Me
          </a>
        </div>
      </div>

      <!-- Image/Visual -->
      <div
        class="relative group z-10 w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96"
      >
        <div
          class="absolute inset-0 bg-gradient-to-tr from-indigo-500 to-purple-500 rounded-full blur-3xl opacity-30 group-hover:opacity-50 transition-opacity duration-700"
        >
        </div>
        <div
          class="relative w-full h-full rounded-[2rem] overflow-hidden border border-white/10 glass-card p-2 md:p-3 transform group-hover:rotate-2 transition-transform duration-500"
        >
          <div class="w-full h-full rounded-2xl overflow-hidden bg-slate-900">
            <Image
              src={profile}
              alt="Kimsinh Seang Profile Picture"
              width={600}
              height={600}
              class="w-full h-full object-cover object-top filter grayscale-[20%] group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100"
              quality="max"
            />
          </div>
        </div>

        <!-- Floating Elements -->
        <div
          class="absolute -bottom-6 -left-6 px-4 py-3 glass-card flex items-center gap-3 animate-bounce shadow-xl"
          style="animation-duration: 3s;"
        >
          <span class="text-2xl">🚀</span>
          <span class="font-medium text-sm">Fullstack Dev</span>
        </div>
        <div
          class="absolute -top-6 -right-6 px-4 py-3 glass-card flex items-center gap-3 animate-bounce shadow-xl"
          style="animation-duration: 4s; animation-delay: 1s;"
        >
          <span class="text-2xl">💻</span>
          <span class="font-medium text-sm">Astro & React</span>
        </div>
      </div>
    </section>

    <!-- Content Sections -->
    <div class="space-y-32">
      <About />
      <Experience />
      <Education />
      <Project />
    </div>
  </main>
</Layout>
