---
import SectionHeading from "./SectionHeading.astro";
import { ArrowUpRight } from "lucide-react";

interface BreakdownRow {
  name: string;
  stack: string;
  /** Omitted for plain fact rows that are not links. */
  url?: string;
  /** `true` renders the row as text; the repo would 404 for visitors. */
  private?: boolean;
}

interface ProjectLink {
  label: string;
  url: string;
}

interface Project {
  title: string;
  eyebrow: string;
  description: string;
  links: [ProjectLink, ...ProjectLink[]];
  /** A structured breakdown, or `tech` chips — a project uses one or the other. */
  breakdown?: BreakdownRow[];
  tech?: string[];
}

// `private: true` repos are not linked — they would 404 for visitors.
// Flip the flag once a repo is made public and it becomes a link.
const projects: Project[] = [
  {
    title: "Scholarize",
    eyebrow: "Capstone project",
    description:
      "A platform for student and advisor collaboration and for discovering research papers. Built as five independent services, including a retrieval-augmented AI assistant that lets users chat directly with a paper — documents are parsed, embedded and queried so answers stay grounded in the source text.",
    breakdown: [
      {
        name: "Frontend",
        stack: "Next.js · MUI · Socket.IO",
        url: "https://github.com/saroto/scholarize_frontend_v2",
        private: true,
      },
      {
        name: "Backend",
        stack: "Go · Gin · GORM · PostgreSQL",
        url: "https://github.com/saroto/scholarize_backend_v2",
        private: false,
      },
      {
        name: "Admin",
        stack: "Next.js · MUI · Redux",
        url: "https://github.com/saroto/scholarize_admin_V2",
        private: true,
      },
      {
        name: "File server",
        stack: "Laravel 11 · PHP 8.2",
        url: "https://github.com/saroto/scholarize_fileServer_V2",
        private: true,
      },
      {
        name: "AI service",
        stack: "FastAPI · LangChain · Gemini · pgvector",
        url: "https://github.com/ArisuYukishiro/Sparcs-AIM-Service",
        private: true,
      },
    ],
    links: [
      {
        label: "Backend repository",
        url: "https://github.com/saroto/scholarize_backend_v2",
      },
    ],
  },
  {
    title: "use-snapping-konva",
    eyebrow: "Open source package",
    description:
      "A lightweight TypeScript utility for Konva.js that adds smart snapping and visual guidelines when dragging or resizing shapes on a canvas. Shapes snap to the stage centre, the stage borders and to each other, with fully configurable guidelines. Framework-agnostic and published to npm.",
    tech: ["TypeScript", "Konva.js", "npm"],
    links: [
      { label: "Repository", url: "https://github.com/saroto/UseSnapKonva" },
      { label: "npm", url: "https://www.npmjs.com/package/use-snapping-konva" },
    ],
  },
  {
    title: "Maxu",
    eyebrow: "Collaboration",
    description:
      "A macOS desktop app that keeps a small floating island at the top of the screen. Expand it to ask an AI about any word or sentence and get an answer in place \u2014 no switching tabs, no losing your place while reading. Shipped to users as a signed disk image through GitHub Releases.",
    breakdown: [
      { name: "Platform", stack: "macOS desktop", private: true },
      { name: "Role", stack: "Collaborator", private: true },
      { name: "Delivery", stack: "Signed .dmg via GitHub Releases", private: true },
    ],
    links: [
      { label: "Repository", url: "https://github.com/ArisuYukishiro/Maxu" },
      {
        label: "Download",
        url: "https://github.com/ArisuYukishiro/Maxu/releases",
      },
    ],
  },
  {
    title: "real-time-leaderboard",
    eyebrow: "roadmap.sh challenge",
    description:
      "A backend for a real-time leaderboard service. Users compete across games, submit scores and see rankings update live — standings are served from Redis sorted sets for sub-millisecond reads, while the full score history is persisted to PostgreSQL through Prisma. JWT authentication, WebSocket updates and Swagger documentation, containerised with Docker Compose.",
    tech: ["NestJS", "TypeScript", "PostgreSQL", "Prisma", "Redis"],
    links: [
      {
        label: "Repository",
        url: "https://github.com/saroto/real-time-leaderboard",
      },
      {
        label: "Challenge",
        url: "https://roadmap.sh/projects/realtime-leaderboard-system",
      },
    ],
  },
];

const pad = (i: number) => String(i + 1).padStart(2, "0");
---

<section id="work" class="scroll-mt-24">
  <SectionHeading
    num="04"
    title="Selected Work"
    note={`${projects.length} projects`}
  />

  <ol class="mt-12 md:mt-16">
    {
      projects.map((project, i) => (
        <li
          data-reveal
          class="group grid grid-cols-12 items-start gap-x-8 gap-y-6 border-t border-rule py-10 transition-colors last:border-b hover:border-rule-strong md:py-14"
        >
          <p class="label nums-tabular col-span-2 pt-2 text-rule-strong transition-colors group-hover:text-brand md:col-span-1">
            {pad(i)}
          </p>

          <div class="col-span-10 md:col-span-6">
            <p class="label mb-3 text-brand">{project.eyebrow}</p>

            <h3 class="font-display text-3xl leading-tight md:text-4xl">
              <a
                href={project.links[0].url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-start gap-2 transition-colors hover:text-brand"
              >
                {project.title}
                <ArrowUpRight
                  size={22}
                  strokeWidth={1.4}
                  className="mt-1.5 shrink-0 opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:opacity-100"
                />
              </a>
            </h3>

            <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
              {project.description}
            </p>

            <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
              {project.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="label link-underline inline-flex items-center gap-1.5 text-foreground hover:text-brand"
                  >
                    {link.label}
                    <ArrowUpRight size={12} strokeWidth={1.8} />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="col-span-12 md:col-span-5 md:pt-2">
            {project.breakdown ? (
              /* Structured breakdown: one hairline row per service or fact.
                 Rows marked private render as plain text, not links. */
              <dl>
                {project.breakdown.map((service) => (
                  <div class="grid grid-cols-3 gap-4 border-t border-rule py-3 last:border-b">
                    <dt class="label pt-0.5 text-foreground">
                      {service.private ? (
                        service.name
                      ) : (
                        <a
                          href={service.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-underline hover:text-brand"
                        >
                          {service.name}
                        </a>
                      )}
                    </dt>
                    <dd class="col-span-2 text-xs leading-relaxed text-muted-foreground">
                      {service.stack}
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <ul class="flex flex-wrap items-center gap-x-3 gap-y-2 md:justify-end">
                {project.tech?.map((t) => (
                  <li class="label border border-rule px-2.5 py-1.5 text-muted-foreground transition-colors group-hover:border-rule-strong">
                    {t}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-10">
    <a
      href="https://github.com/saroto"
      target="_blank"
      rel="noopener noreferrer"
      class="label link-underline inline-flex items-center gap-2 text-foreground hover:text-brand"
    >
      All repositories on GitHub
      <ArrowUpRight size={13} strokeWidth={1.8} />
    </a>
  </div>
</section>
