---
import { Folder, ExternalLink, Github } from "lucide-react";

const projects = [
  {
    title: "E-Commerce Platform Redesign",
    description: "A full-scale redesign and migration of an existing WordPress e-commerce site to a modern headless Next.js architecture.",
    tech: ["Next.js", "TailwindCSS", "Stripe", "PostgreSQL"],
    github: "https://github.com/saroto",
    live: "#",
    featured: true
  },
  {
    title: "AI Auto-Reply Bot",
    description: "An intelligent Facebook comment moderation and auto-reply system leveraging LLMs and the Facebook Graph API to streamline social media management.",
    tech: ["Node.js", "Meta Graph API", "OpenAI", "Express"],
    github: "https://github.com/saroto",
    live: "#",
    featured: false
  },
  {
    title: "Internal Operations Dashboard",
    description: "A comprehensive Role-Based Access Control (RBAC) dashboard built to help clients manage internal workflows, employee data, and analytics securely.",
    tech: ["Vue.js", "Golang", "Docker", "Nginx"],
    github: "https://github.com/saroto",
    live: "#",
    featured: false
  },
  {
    title: "Modern Portfolio V2",
    description: "The very site you are looking at right now. Built for speed, accessibility, and featuring an immersive glassmorphic design system.",
    tech: ["Astro", "React", "TailwindCSS", "Framer Motion"],
    github: "https://github.com/saroto/portfolio",
    live: "#",
    featured: true
  }
];
---

<section id="projects" class="scroll-mt-24">
  <div class="flex items-center gap-4 mb-8 opacity-80">
    <div class="h-[1px] w-12 bg-indigo-500"></div>
    <h2 class="text-indigo-400 font-semibold tracking-wider uppercase text-sm flex items-center gap-2">
      <Folder size={16} /> Featured Projects
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <div class="glass-card flex flex-col justify-between p-8 group hover:-translate-y-2 transition-all duration-500 border border-white/5 hover:border-indigo-500/30 relative overflow-hidden">
        
        <!-- Subtle Glow Effect -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl group-hover:bg-indigo-500/20 transition-colors duration-500"></div>

        <div class="relative z-10 flex flex-col h-full">
          <div class="flex justify-between items-start mb-6">
            <div class="p-3 rounded-xl bg-white/5 text-indigo-400 group-hover:text-indigo-300 transition-colors">
              <Folder size={28} strokeWidth={1.5} />
            </div>
            <div class="flex gap-4">
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors" aria-label="GitHub Repository">
                <Github size={20} />
              </a>
              {project.live !== "#" && (
                <a href={project.live} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-indigo-400 transition-colors" aria-label="Live Project">
                  <ExternalLink size={20} />
                </a>
              )}
            </div>
          </div>
          
          <div>
            <h3 class="font-outfit text-2xl font-bold text-slate-200 group-hover:text-white transition-colors mb-4">
              {project.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
              {project.description}
            </p>
          </div>

          <div class="mt-auto pt-6 flex flex-wrap gap-2 border-t border-white/5">
            {project.tech.map((t) => (
              <span class="text-xs font-mono text-slate-500 group-hover:text-indigo-300 transition-colors">
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
  
  <div class="mt-12 flex justify-center">
    <a href="https://github.com/saroto" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-full border border-white/10 text-slate-300 font-medium hover:bg-white/5 hover:text-white transition-all flex items-center gap-2">
      View All on GitHub <Github size={18} />
    </a>
  </div>
</section>
