---
import SectionHeading from "./SectionHeading.astro";

const capabilities = [
  { name: "Frontend", detail: "React, Next.js, Astro, Vue" },
  { name: "Backend", detail: "Node.js, Express" },
  { name: "Database", detail: "PostgreSQL, MongoDB, Redis" },
  { name: "Tools", detail: "Git, Docker, CI/CD, Nginx" },
];
---

<section id="about" class="scroll-mt-24">
  <SectionHeading num="01" title="About" note="Phnom Penh, Cambodia" />

  <div class="mt-12 grid grid-cols-12 gap-x-8 gap-y-14 md:mt-16">
    <!-- The thesis, set large -->
    <p
      data-reveal
      class="col-span-12 font-display text-title text-balance lg:col-span-10"
    >
      I build <em class="italic text-brand">robust, scalable</em> and visually appealing
      web applications &mdash; turning complex challenges into elegant solutions.
    </p>

    <!-- Running text, held to a comfortable measure -->
    <div
      data-reveal
      class="col-span-12 space-y-5 text-muted-foreground md:col-span-7 lg:col-span-6 lg:col-start-1"
    >
      <p class="leading-relaxed">
        I&rsquo;m a software developer with a strong foundation in computer
        science, blending technical expertise with creative problem-solving.
        Whether it&rsquo;s crafting seamless frontend interfaces or architecting
        solid backend systems, I care about the details that make software feel
        considered.
      </p>
      <p class="leading-relaxed">
        When I&rsquo;m not coding, I&rsquo;m exploring new technologies or
        contributing to the developer community.
      </p>
    </div>

    <!-- Capabilities as a definition table, hairline separated -->
    <dl
      data-reveal
      class="col-span-12 md:col-span-5 lg:col-span-5 lg:col-start-8"
    >
      {
        capabilities.map((cap) => (
          <div class="grid grid-cols-3 gap-4 border-t border-rule py-4 last:border-b">
            <dt class="label pt-0.5 text-foreground">{cap.name}</dt>
            <dd class="col-span-2 text-sm text-muted-foreground">
              {cap.detail}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
