---
import SectionHeading from "./SectionHeading.astro";
import { ArrowUpRight } from "lucide-react";

const email = "skimsinh@gmail.com";

// What a client can hire me to build, phrased as outcomes rather than tools.
const services = [
  { name: "Web apps", detail: "Next.js, Nuxt, Vue, Astro" },
  {
    name: "Mobile apps",
    detail: "Flutter — iOS and Android from one codebase",
  },
  { name: "APIs & backends", detail: "Go, NestJS, Laravel, PostgreSQL" },
  {
    name: "AI features",
    detail: "Chat over your own documents, RAG pipelines",
  },
];

const channels = [
  {
    name: "Upwork",
    handle: "Hire me",
    url: "https://www.upwork.com/freelancers/~01fe34ef86ac1c5281?viewMode=1",
  },
  { name: "GitHub", handle: "@saroto", url: "https://github.com/saroto" },
  {
    name: "LinkedIn",
    handle: "Kimsinh Seang",
    url: "https://www.linkedin.com/in/kimsinh-seang-6594b9201/",
  },
  { name: "Telegram", handle: "@skimsinh", url: "https://t.me/skimsinh" },
];
---

<section id="contact" class="scroll-mt-24">
  <SectionHeading num="05" title="Contact" note="Open to new opportunities" />

  <div class="mt-12 grid grid-cols-12 gap-x-8 gap-y-14 md:mt-16">
    <div class="col-span-12 lg:col-span-7">
      <p data-reveal class="font-display text-title text-balance">
        Have something in mind?
        <span class="italic text-brand">Let&rsquo;s talk.</span>
      </p>

      <a
        data-reveal
        href={`mailto:${email}`}
        class="link-underline mt-8 inline-block font-display text-2xl leading-tight hover:text-brand sm:text-4xl"
      >
        {email}
      </a>

      <p
        data-reveal
        class="mt-6 max-w-md text-sm leading-relaxed text-muted-foreground"
      >
        Available for freelance and contract work. Tell me what you are building
        and I will tell you honestly whether I am the right fit.
      </p>

      <dl data-reveal class="mt-10 max-w-md">
        <p class="label mb-1 text-foreground">What I build</p>
        {
          services.map((service) => (
            <div class="grid grid-cols-3 gap-4 border-t border-rule py-3.5 last:border-b">
              <dt class="label pt-0.5 text-foreground">{service.name}</dt>
              <dd class="col-span-2 text-xs leading-relaxed text-muted-foreground">
                {service.detail}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul data-reveal class="col-span-12 lg:col-span-5">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-baseline justify-between gap-6 border-t border-rule py-5 transition-colors hover:border-rule-strong"
            >
              <span class="label text-foreground transition-colors group-hover:text-brand">
                {channel.name}
              </span>
              <span class="flex items-center gap-2 text-sm text-muted-foreground transition-colors group-hover:text-foreground">
                {channel.handle}
                <ArrowUpRight
                  size={14}
                  strokeWidth={1.6}
                  className="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
