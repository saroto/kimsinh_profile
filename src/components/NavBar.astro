---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { num: "01", label: "About", href: "#about" },
  { num: "02", label: "Experience", href: "#experience" },
  { num: "03", label: "Education", href: "#education" },
  { num: "04", label: "Work", href: "#work" },
  { num: "05", label: "Contact", href: "#contact" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-rule bg-background/80 backdrop-blur-md"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href="#top"
      class="font-display text-xl leading-none tracking-tight hover:text-brand"
    >
      Kimsinh Seang
    </a>

    <nav class="flex items-center gap-6 sm:gap-8">
      <ul class="hidden items-baseline gap-6 sm:flex md:gap-8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link={link.href}
                class="group flex items-baseline gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=true]:text-foreground"
              >
                <span class="label nums-tabular text-[0.625rem] transition-colors group-hover:text-brand group-aria-[current=true]:text-brand">
                  {link.num}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggle />
    </nav>
  </div>
</header>

<script is:inline>
  // Mark the section currently in view. Purely decorative; safe to no-op.
  (() => {
    const navLinks = [...document.querySelectorAll("[data-nav-link]")];
    if (!navLinks.length || !("IntersectionObserver" in window)) return;

    const byId = new Map(
      navLinks.map((a) => [a.getAttribute("data-nav-link").slice(1), a]),
    );
    const sections = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    const visible = new Set();

    const paint = () => {
      // Topmost visible section wins.
      const active = sections.find((s) => visible.has(s.id))?.id;
      for (const [id, a] of byId) {
        if (id === active) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        paint();
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );

    sections.forEach((s) => io.observe(s));
  })();
</script>
