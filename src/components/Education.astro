---
import SectionHeading from "./SectionHeading.astro";
---

<section id="education" class="scroll-mt-24">
  <SectionHeading num="03" title="Education" />

  <div class="mt-12 md:mt-16">
    <article
      data-reveal
      class="group grid grid-cols-12 gap-x-8 gap-y-4 border-y border-rule py-10 transition-colors hover:border-rule-strong md:py-12"
    >
      <div class="col-span-12 md:col-span-3">
        <p class="label nums-tabular">2021 &mdash; 2025</p>
        <p class="label mt-3 text-brand">Graduated with honours</p>
      </div>

      <div class="col-span-12 md:col-span-9">
        <h3
          class="font-display text-3xl leading-tight transition-colors group-hover:text-brand md:text-4xl"
        >
          Bachelor of Computer Science
        </h3>
        <p class="mt-1.5 text-sm text-muted-foreground">
          Paragon International University
        </p>
        <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          Focused on software engineering, algorithms, and system architecture.
          Developed a strong foundation in modern web development
          methodologies and database management.
        </p>
      </div>
    </article>
  </div>
</section>
