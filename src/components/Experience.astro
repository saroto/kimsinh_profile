---
import SectionHeading from "./SectionHeading.astro";

interface Experience {
  role: string;
  company: string;
  period: string;
  current: boolean;
  /** Static marker for delivered work, e.g. "Shipped". No live ping. */
  status?: string;
  description: string[];
  tech: string[];
}

const experiences: Experience[] = [
  {
    role: "Frontend Software Developer",
    company: "Digital Economy and Business Committee",
    period: "Jan 2026 — Present",
    current: true,
    description: [
      "Building a comprehensive web application for the ministry, with a primary focus on digital public services.",
      "Architecting and developing modern, responsive user interfaces to serve citizens efficiently.",
    ],
    tech: ["Nuxt.js", "Vue.js", "TailwindCSS"],
  },
  {
    role: "Mobile App Developer",
    company: "GoLoca \u2014 Freelance",
    period: "Released",
    current: false,
    status: "Shipped",
    description: [
      "Built a mobile app that helps people find places to eat, relax, unwind or celebrate with family and friends.",
      "Implemented promotion and happy hour listings so users can discover what is on offer nearby.",
      "Developed a stamp system that rewards repeat visits to a venue.",
      "Added in-app booking so users can reserve a place ahead of time.",
    ],
    tech: ["Flutter", "Dart"],
  },
  {
    role: "Web Developer",
    company: "Apsara Media Services (AMS)",
    period: "May 2025 — Dec 2025",
    current: false,
    description: [
      "Maintained and updated the AMS3E WordPress website.",
      "Developed a new responsive website from scratch using Nuxt.js.",
      "Integrated APIs to enhance functionality and user experience.",
      "Ensured optimal performance, security, and cross-browser compatibility.",
      "Built a Facebook auto-reply comment system using Graph API and LLM for smart automation.",
    ],
    tech: ["Nuxt.js", "Vue", "WordPress", "Graph API", "LLMs"],
  },
  {
    role: "Frontend Developer",
    company: "Advance MSP",
    period: "2024 — 2025",
    current: false,
    description: [
      "Developed and maintained responsive web applications using Next.js.",
      "Integrated RESTful APIs and improved system performance.",
      "Collaborated with backend developers to ensure seamless communication.",
      "Contributed to backend tasks when needed.",
    ],
    tech: ["Next.js", "React", "REST APIs", "TailwindCSS"],
  },
  {
    role: "Fullstack / Frontend Developer",
    company: "Freelance",
    period: "2024 — 2025",
    current: false,
    description: [
      "Developed a web application to help clients streamline internal operations.",
      "Built the frontend using Next.js for performance and scalability.",
      "Implemented NextAuth.js for secure authentication and session management.",
      "Applied RBAC for user permission control and system access.",
      "Contributed to backend development using Golang for a scalable system.",
      "Implemented CI/CD pipelines and optimized Nginx and server infrastructure.",
    ],
    tech: ["Next.js", "Golang", "NextAuth", "Docker", "Nginx", "CI/CD"],
  },
];
---

<section id="experience" class="scroll-mt-24">
  <SectionHeading
    num="02"
    title="Experience"
    note={`${experiences.length} roles`}
  />

  <div class="mt-12 md:mt-16">
    {
      experiences.map((exp) => (
        <article
          data-reveal
          class="group grid grid-cols-12 gap-x-8 gap-y-4 border-t border-rule py-10 transition-colors hover:border-rule-strong md:py-12"
        >
          {/* Dateline */}
          <div class="col-span-12 flex items-center gap-3 md:col-span-3 md:block">
            <p class="label nums-tabular">{exp.period}</p>
            {exp.current && (
              <p class="label mt-0 flex items-center gap-1.5 text-brand md:mt-3">
                <span class="relative flex h-1.5 w-1.5">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60" />
                  <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand" />
                </span>
                Current
              </p>
            )}
            {exp.status && (
              <p class="label mt-0 text-brand md:mt-3">{exp.status}</p>
            )}
          </div>

          {/* Body */}
          <div class="col-span-12 md:col-span-9">
            <h3 class="font-display text-3xl leading-tight transition-colors group-hover:text-brand md:text-4xl">
              {exp.role}
            </h3>
            <p class="mt-1.5 text-sm text-muted-foreground">{exp.company}</p>

            <ul class="mt-6 max-w-2xl space-y-2.5">
              {exp.description.map((item) => (
                <li class="grid grid-cols-[1rem_1fr] text-sm leading-relaxed text-muted-foreground">
                  <span class="select-none text-rule-strong">&mdash;</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
              {exp.tech.map((t) => (
                <li class="label border border-rule px-2.5 py-1.5 text-muted-foreground transition-colors group-hover:border-rule-strong">
                  {t}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
